# ============================================================================
# EXTRANJERÍA SEGURA — variables de entorno
#
# Copia este archivo a `.env.local` y rellena los valores.
# NUNCA subas `.env.local` al repositorio.
# ============================================================================

# --- Sitio -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://extranjeria-segura.vercel.app

# --- Supabase --------------------------------------------------------------
# La clave anon es pública por diseño: toda la seguridad la aplica RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La service role SOLO en funciones de servidor auditadas (borrado programado,
# generación de facturas). Nunca en código que llegue al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (correo transaccional) -----------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Reseñas verificables (opcional) ---------------------------------------
NEXT_PUBLIC_GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
